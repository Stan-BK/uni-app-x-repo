POSTGRES_USER=activity
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=activity
DATABASE_URL=postgresql://activity:change-me-postgres@postgres:5432/activity?schema=public
JWT_USER_SECRET=change-me-user
JWT_ADMIN_SECRET=change-me-admin
JWT_EXPIRES_IN=7d
WEIXIN_APPID=
WEIXIN_SECRET=
AUTH_DEV_BYPASS=
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow!
PUBLIC_API_BASE=http://127.0.0.1/api

# 镜像来源。只给 Compose / ctl.sh 用，API 进程不读取。
# 留空则 bootstrap / release / up 在本机 build（现有行为）。
# 填 ACR 引用后，上述命令改为 pull，不再在 ECS 上编译。
# 生产流水线请用 ./deploy/ctl.sh release --pull（或 ./deploy/ecs-pull-release.sh），
# 避免变量没注入时退回本机构建。强制本机构建：./deploy/ctl.sh release --build
# 示例（命名空间换成 ACR 控制台里的，不要写仓库密码）:
# API_IMAGE=registry.cn-shenzhen.aliyuncs.com/<命名空间>/deploy-api:20261105120000
API_IMAGE=
