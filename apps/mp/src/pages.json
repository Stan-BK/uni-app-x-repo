{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "活动首页",
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/activity/detail",
      "style": {
        "navigationBarTitleText": "活动详情",
        "enableShareAppMessage": true,
        "enableShareTimeline": true
      }
    },
    {
      "path": "pages/register/index",
      "style": {
        "navigationBarTitleText": "报名表单"
      }
    },
    {
      "path": "pages/mine/registrations",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/organizer/home",
      "style": {
        "navigationBarTitleText": "发布"
      }
    },
    {
      "path": "pages/organizer/create",
      "style": {
        "navigationBarTitleText": "发布活动"
      }
    },
    {
      "path": "pages/organizer/list",
      "style": {
        "navigationBarTitleText": "我的活动"
      }
    },
    {
      "path": "pages/organizer/detail",
      "style": {
        "navigationBarTitleText": "活动详情"
      }
    },
    {
      "path": "pages/organizer/registrations",
      "style": {
        "navigationBarTitleText": "报名名单"
      }
    }
  ],
  "tabBar": {
    "color": "#9CA3AF",
    "selectedColor": "#0F766E",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tab-home.png",
        "selectedIconPath": "static/tab-home-active.png"
      },
      {
        "pagePath": "pages/mine/registrations",
        "text": "我的",
        "iconPath": "static/tab-mine.png",
        "selectedIconPath": "static/tab-mine-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "活动",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F4F5F7"
  }
}
