generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityProvider {
  weixin
  toutiao
  xhs
}

enum AdminRole {
  operator
  admin
}

enum UserStatus {
  active
  banned
}

enum ActivityLifecycle {
  draft
  published
  cancelled
  removed
  ended
}

enum FeeType {
  free
  paid
}

enum RegistrationStatus {
  pending_review
  pending_payment
  confirmed
  rejected
  cancelled
}

enum PaymentOrderStatus {
  pending
  paid
  closed
  refunded
}

enum RefundStatus {
  processing
  succeeded
  failed
}

enum RefundReason {
  user_cancel
  activity_closed
}

enum LedgerEntryType {
  settlement_credit
}

enum SubscribeMessageKind {
  registration_confirmed
  activity_starting
}

enum SubscribeMessageJobStatus {
  pending
  sent
  skipped
  cancelled
}

model User {
  id        String     @id @default(cuid())
  nickname  String?
  avatarUrl String?
  realName  String?
  phone     String?
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  canPublish    Boolean        @default(true)
  identities    UserIdentity[]
  activities    Activity[]
  registrations Registration[]
  wallet        WalletAccount?
  settlements   ActivitySettlement[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  notificationsReceived Notification[]       @relation("NotificationRecipient")
  notificationsActed    Notification[]       @relation("NotificationActor")
}

model UserIdentity {
  id        String           @id @default(cuid())
  userId    String
  provider  IdentityProvider
  openId    String
  unionId   String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@unique([provider, openId])
  @@index([userId])
}

model Activity {
  id             String            @id @default(cuid())
  ownerUserId    String
  title          String
  coverUrl       String            @default("")
  category       String            @default("")
  description    String?
  rules          String            @default("")
  startAt                  DateTime?
  endAt                    DateTime?
  registrationDeadlineAt   DateTime?
  allowUserCancel          Boolean           @default(true)
  refundable               Boolean           @default(false)
  place                    String            @default("")
  placeLat                 Float?
  placeLng                 Float?
  capacity                 Int               @default(1)
  feeType                  FeeType           @default(free)
  feeCents                 Int               @default(0)
  feeNote                  String?
  lifecycle                ActivityLifecycle @default(draft)
  cancelReason   String?
  removeReason   String?
  platformFeeBps Int?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  owner          User              @relation(fields: [ownerUserId], references: [id])
  registrations  Registration[]
  settlement     ActivitySettlement?
  postLinks      PostActivityLink[]

  @@index([ownerUserId, lifecycle])
  @@index([lifecycle, startAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(operator)
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Registration {
  id          String             @id @default(cuid())
  activityId  String
  userId      String
  name        String
  phone       String
  status      RegistrationStatus @default(confirmed)
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  activity       Activity        @relation(fields: [activityId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  paymentOrders  PaymentOrder[]
  subscribeMessageJobs SubscribeMessageJob[]

  @@unique([userId, activityId])
  @@index([activityId, status])
  @@index([userId, createdAt])
}

model SubscribeMessageJob {
  id             String                     @id @default(cuid())
  registrationId String
  kind           SubscribeMessageKind
  dueAt          DateTime
  status         SubscribeMessageJobStatus  @default(pending)
  attemptCount   Int                        @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  registration   Registration               @relation(fields: [registrationId], references: [id])

  @@unique([registrationId, kind])
  @@index([status, dueAt])
}

/// Partial unique indexes (one pending / one paid per registration) are defined in migration 20261024120000_paid_registration_payment only.
model PaymentOrder {
  id             String             @id @default(cuid())
  registrationId String
  outTradeNo     String             @unique
  amountCents    Int
  status         PaymentOrderStatus @default(pending)
  prepayId       String?
  transactionId  String?
  expireAt       DateTime
  paidAt         DateTime?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  registration   Registration       @relation(fields: [registrationId], references: [id])
  refund         Refund?

  @@index([registrationId, status])
  @@index([status, expireAt])
}

model Refund {
  id             String       @id @default(cuid())
  paymentOrderId String       @unique
  outRefundNo    String       @unique
  amountCents    Int
  status         RefundStatus
  reason         RefundReason
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id])
}

model WalletAccount {
  id             String        @id @default(cuid())
  userId         String        @unique
  /// Non-negative balance enforced by CHECK in migration SQL (Prisma cannot express it).
  availableCents Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id])
  entries        LedgerEntry[]
}

model LedgerEntry {
  id                  String          @id @default(cuid())
  accountId           String
  type                LedgerEntryType
  availableDeltaCents Int
  availableAfterCents Int
  idempotencyKey      String          @unique
  refType             String
  refId               String
  createdAt           DateTime        @default(now())
  account             WalletAccount   @relation(fields: [accountId], references: [id])
}

model ActivitySettlement {
  id            String   @id @default(cuid())
  activityId    String   @unique
  ownerUserId   String
  grossCents    Int
  refundedCents Int
  platformFeeBps Int
  feeCents      Int
  netCents      Int
  ledgerEntryId String?  @unique
  createdAt     DateTime @default(now())
  activity      Activity @relation(fields: [activityId], references: [id])
  owner         User     @relation(fields: [ownerUserId], references: [id])
}

enum CommunityDeletedBy {
  author
  admin
}

enum LikeTargetType {
  post
  comment
}

enum NotificationType {
  like_post
  like_comment
  comment_post
  reply_comment
}

model Post {
  id            String              @id @default(cuid())
  authorId      String
  body          String              @default("")
  likeCount     Int                 @default(0)
  commentCount  Int                 @default(0)
  deletedAt     DateTime?
  deletedBy     CommunityDeletedBy?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  author        User                @relation(fields: [authorId], references: [id])
  images        PostImage[]
  activityLinks PostActivityLink[]
  comments      Comment[]
  notifications Notification[]

  @@index([deletedAt, createdAt])
  @@index([authorId, deletedAt, createdAt])
}

model PostImage {
  id        String @id @default(cuid())
  postId    String
  url       String
  sortOrder Int    @default(0)
  post      Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostActivityLink {
  id         String   @id @default(cuid())
  postId     String
  activityId String
  sortOrder  Int      @default(0)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id])

  @@unique([postId, activityId])
  @@index([activityId])
}

model Comment {
  id            String              @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?
  body          String              @default("")
  imageUrl      String?
  likeCount     Int                 @default(0)
  deletedAt     DateTime?
  deletedBy     CommunityDeletedBy?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  post          Post                @relation(fields: [postId], references: [id])
  author        User                @relation(fields: [authorId], references: [id])
  parent        Comment?            @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[]           @relation("CommentReplies")
  notifications Notification[]

  @@index([postId, deletedAt, createdAt])
  @@index([parentId])
}

model Like {
  id         String         @id @default(cuid())
  userId     String
  targetType LikeTargetType
  targetId   String
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id])

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String
  type        NotificationType
  postId      String
  commentId   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id])
  post        Post             @relation(fields: [postId], references: [id])
  comment     Comment?         @relation(fields: [commentId], references: [id])

  @@index([recipientId, readAt, createdAt])
}
