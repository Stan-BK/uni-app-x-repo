generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityProvider {
  weixin
  toutiao
  xhs
}

enum AdminRole {
  operator
  admin
}

enum UserStatus {
  active
  banned
}

enum ActivityLifecycle {
  draft
  published
  cancelled
  removed
  ended
}

enum FeeType {
  free
  paid
}

enum RegistrationStatus {
  pending_review
  confirmed
  rejected
  cancelled
}

model User {
  id        String     @id @default(cuid())
  nickname  String?
  avatarUrl String?
  realName  String?
  phone     String?
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  canPublish    Boolean        @default(true)
  identities    UserIdentity[]
  activities    Activity[]
  registrations Registration[]
}

model UserIdentity {
  id        String           @id @default(cuid())
  userId    String
  provider  IdentityProvider
  openId    String
  unionId   String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@unique([provider, openId])
  @@index([userId])
}

model Activity {
  id             String            @id @default(cuid())
  ownerUserId    String
  title          String
  coverUrl       String            @default("")
  category       String            @default("")
  description    String?
  rules          String            @default("")
  startAt                  DateTime?
  endAt                    DateTime?
  registrationDeadlineAt   DateTime?
  allowUserCancel          Boolean           @default(true)
  refundable               Boolean           @default(false)
  place                    String            @default("")
  placeLat                 Float?
  placeLng                 Float?
  capacity                 Int               @default(1)
  feeType                  FeeType           @default(free)
  feeCents                 Int               @default(0)
  feeNote                  String?
  lifecycle                ActivityLifecycle @default(draft)
  cancelReason   String?
  removeReason   String?
  platformFeeBps Int?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  owner          User              @relation(fields: [ownerUserId], references: [id])
  registrations  Registration[]

  @@index([ownerUserId, lifecycle])
  @@index([lifecycle, startAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  role         AdminRole @default(operator)
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Registration {
  id          String             @id @default(cuid())
  activityId  String
  userId      String
  name        String
  phone       String
  status      RegistrationStatus @default(confirmed)
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  activity    Activity           @relation(fields: [activityId], references: [id])
  user        User               @relation(fields: [userId], references: [id])

  @@unique([userId, activityId])
  @@index([activityId, status])
  @@index([userId, createdAt])
}
