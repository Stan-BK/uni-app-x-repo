DATABASE_URL=postgresql://postgres:postgres@localhost:5432/activity?schema=public
JWT_USER_SECRET=dev-user-secret-change-me
JWT_ADMIN_SECRET=dev-admin-secret-change-me
JWT_EXPIRES_IN=7d
WEIXIN_APPID=
WEIXIN_SECRET=
AUTH_DEV_BYPASS=true
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow!
PORT=3000
HOST=0.0.0.0
# 小程序/客户端访问上传文件的 API 前缀（真机预览请改成电脑局域网 IP，勿尾斜杠）
PUBLIC_API_BASE=http://127.0.0.1:3000/api
# 微信一次性订阅消息（两端模板 ID 须与小程序 VITE_ 同名变量一致；未配置则到期任务 skipped）
WEIXIN_SUBSCRIBE_TMPL_REGISTRATION_CONFIRMED=
WEIXIN_SUBSCRIBE_TMPL_ACTIVITY_STARTING=
WEIXIN_SUBSCRIBE_MINIPROGRAM_STATE=developer
