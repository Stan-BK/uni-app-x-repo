{
  "name": "activity-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mp-weixin": "pnpm --filter @activity/mp dev:mp-weixin",
    "dev:mp-toutiao": "pnpm --filter @activity/mp dev:mp-toutiao",
    "dev:mp-xhs": "pnpm --filter @activity/mp dev:mp-xhs",
    "dev:h5": "pnpm --filter @activity/mp dev:h5",
    "build:mp-weixin": "pnpm --filter @activity/mp build:mp-weixin",
    "build:mp-toutiao": "pnpm --filter @activity/mp build:mp-toutiao",
    "build:mp-xhs": "pnpm --filter @activity/mp build:mp-xhs",
    "dev:api": "pnpm --filter @activity/api start:dev",
    "dev:admin": "pnpm --filter @activity/admin dev",
    "type-check": "pnpm -r --if-present type-check",
    "lint": "pnpm -r --if-present lint"
  }
}
